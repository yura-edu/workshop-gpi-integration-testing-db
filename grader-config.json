{
  "schemaVersion": "1.0",
  "templateSlug": "gpi-integration-testing-db",
  "evaluationBlocks": [
    {
      "blockId": "auto",
      "evaluationType": "automated_pipeline",
      "metrics": [
        {
          "metricKey": "test_coverage",
          "worker": "TestWorker",
          "weight": 30,
          "threshold": 0.75,
          "config": {
            "coverageCommand": "npm run test:coverage",
            "coverageFormat": "json-summary",
            "coveragePath": "starter-code/coverage/coverage-summary.json",
            "minLineCoverage": 75
          }
        },
        {
          "metricKey": "test_pass_rate",
          "worker": "TestWorker",
          "weight": 25,
          "threshold": 1.0,
          "config": {
            "testCommand": "npm test",
            "workdir": "starter-code",
            "requireAllPass": true
          }
        },
        {
          "metricKey": "integration_test_count",
          "worker": "TestAnalyzer",
          "weight": 20,
          "threshold": 8,
          "config": {
            "testDir": "starter-code/tests/integration",
            "pattern": "*.test.ts",
            "minCount": 8
          }
        },
        {
          "metricKey": "ci_pipeline_passes",
          "worker": "CiRunner",
          "weight": 15,
          "threshold": 1.0,
          "config": {
            "requireDockerCompose": true,
            "composeFile": "compose.test.yml"
          }
        },
        {
          "metricKey": "config_file_valid_schema",
          "worker": "ConfigValidator",
          "weight": 10,
          "threshold": 1.0,
          "config": {
            "filePath": "starter-code/compose.test.yml",
            "requiredImage": "postgres",
            "requiredPort": 5433
          }
        }
      ]
    }
  ]
}
